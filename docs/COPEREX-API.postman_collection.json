{
	"info": {
		"_postman_id": "coperex-api-collection",
		"name": "COPEREX-API - Feria Interfer",
		"description": "Colección de la API COPEREX (Feria Interfer). Incluye todos los endpoints documentados.\n\nAutenticación: todas las rutas excepto Login requieren token JWT en header Authorization: Bearer <token> o x-token. El request Login guarda el token en la variable {{token}}; el resto de requests de la colección usan Authorization: Bearer {{token}}.\n\nRespuestas 401: token faltante (mensaje indica usar Authorization: Bearer), token expirado o token inválido. Para obtener un token nuevo se debe ejecutar de nuevo el request Login.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000"
		},
		{
			"key": "token",
			"value": ""
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.token) {",
									"    pm.collectionVariables.set('token', json.token);",
									"    console.log('✅ Token guardado correctamente');",
									"} else {",
									"    console.log('❌ No se encontró token en la respuesta');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@coperex.com\",\n    \"password\": \"Admin123!\"\n}"
						},
						"url": {
							"raw": "http://localhost:3000/coperex/v1/auth/login",
							"host": ["http://localhost:3000"],
							"path": ["coperex", "v1", "auth", "login"]
						},
						"description": "Login de administrador. La respuesta incluye token; el test script guarda el token en la variable de colección {{token}}."
					}
				},
				{
					"name": "Me (perfil del admin logueado)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "http://localhost:3000/coperex/v1/auth/me",
							"host": ["http://localhost:3000"],
							"path": ["coperex", "v1", "auth", "me"]
						},
						"description": "Obtiene el perfil del administrador asociado al token (campo sub del JWT)."
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "http://localhost:3000/coperex/v1/auth/logout",
							"host": ["http://localhost:3000"],
							"path": ["coperex", "v1", "auth", "logout"]
						},
						"description": "Cierre de sesión. Requiere token válido; el cliente debe dejar de usar el token tras la respuesta."
					}
				}
			]
		},
		{
			"name": "Admins",
			"item": [
				{
					"name": "Listar todos los admins",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "http://localhost:3000/coperex/v1/admins",
							"host": ["http://localhost:3000"],
							"path": ["coperex", "v1", "admins"]
						}
					}
				},
				{
					"name": "Obtener admin por ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "http://localhost:3000/coperex/v1/admins/:id",
							"host": ["http://localhost:3000"],
							"path": ["coperex", "v1", "admins", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "",
									"description": "ID del administrador (MongoDB ObjectId)"
								}
							]
						}
					}
				},
				{
					"name": "Crear administrador",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Nuevo Admin\",\n    \"email\": \"nuevo@coperex.com\",\n    \"password\": \"Password123\"\n}"
						},
						"url": {
							"raw": "http://localhost:3000/coperex/v1/admins",
							"host": ["http://localhost:3000"],
							"path": ["coperex", "v1", "admins"]
						},
						"description": "Crear administrador. name: mínimo 3 caracteres. password: mínimo 8, al menos una mayúscula y un número. Validación en admin.validators."
					}
				},
				{
					"name": "Actualizar administrador",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Nombre Actualizado\",\n    \"email\": \"actualizado@coperex.com\"\n}"
						},
						"url": {
							"raw": "http://localhost:3000/coperex/v1/admins/:id",
							"host": ["http://localhost:3000"],
							"path": ["coperex", "v1", "admins", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "",
									"description": "ID del administrador a editar (MongoDB ObjectId). No aplicable al admin autenticado."
								}
							]
						},
						"description": "Actualizar nombre y/o email. Esta ruta no permite editar el perfil del admin autenticado."
					}
				},
				{
					"name": "Cambiar mi contraseña",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"currentPassword\": \"Admin123!\",\n    \"newPassword\": \"NuevaPassword123\"\n}"
						},
						"url": {
							"raw": "http://localhost:3000/coperex/v1/admins/change-password",
							"host": ["http://localhost:3000"],
							"path": ["coperex", "v1", "admins", "change-password"]
						}
					}
				}
			]
		},
		{
			"name": "Companies",
			"item": [
				{
					"name": "Listar empresas",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "http://localhost:3000/coperex/v1/companies?sort=AZ",
							"host": ["http://localhost:3000"],
							"path": ["coperex", "v1", "companies"],
							"query": [
								{
									"key": "category",
									"value": "TECNOLOGÍA",
									"disabled": true,
									"description": "TECNOLOGÍA | SALUD | EDUCACIÓN | COMERCIO | INDUSTRIA | SERVICIOS | OTRO"
								},
								{
									"key": "impactLevel",
									"value": "NACIONAL",
									"disabled": true,
									"description": "LOCAL | NACIONAL | INTERNACIONAL"
								},
								{
									"key": "yearsOfExperience",
									"value": "5",
									"disabled": true,
									"description": "Años de trayectoria (exacto): empresas con exactamente N años"
								},
								{
									"key": "minYears",
									"value": "0",
									"disabled": true,
									"description": "Años de trayectoria (mínimo): empresas con al menos N años"
								},
								{
									"key": "maxYears",
									"value": "100",
									"disabled": true,
									"description": "Años de trayectoria (máximo): empresas con hasta N años"
								},
								{
									"key": "sort",
									"value": "AZ",
									"description": "AZ = A→Z  |  ZA = Z→A"
								}
							]
						},
						"description": "PMA punto 3 - Visualización. Listado completo de empresas registradas. Filtros: por años de trayectoria (yearsOfExperience exacto o minYears/maxYears), por categoría (category), por nivel de impacto (impactLevel). Orden: sort=AZ (A-Z) o sort=ZA (Z-A). Params opcionales en pestaña Params."
					}
				},
				{
					"name": "Descargar reporte Excel",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "http://localhost:3000/coperex/v1/companies/report",
							"host": ["http://localhost:3000"],
							"path": ["coperex", "v1", "companies", "report"]
						},
						"description": "Devuelve un archivo .xlsx con todas las empresas (Empresas_Interfer.xlsx). En Postman usar Send and Download para guardar el archivo."
					}
				},
				{
					"name": "Obtener una empresa por ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "http://localhost:3000/coperex/v1/companies/:id",
							"host": ["http://localhost:3000"],
							"path": ["coperex", "v1", "companies", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "",
									"description": "ID de la empresa (MongoDB ObjectId)"
								}
							]
						},
						"description": "PMA punto 3 - Visualización. Obtiene el detalle de una empresa por su ID."
					}
				},
				{
					"name": "Registrar empresa",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"companyName\": \"Mi Empresa SA\",\n    \"impactLevel\": \"NACIONAL\",\n    \"yearsOfExperience\": 5,\n    \"category\": \"TECNOLOGÍA\",\n    \"description\": \"Descripción opcional de la empresa\",\n    \"contactEmail\": \"contacto@miempresa.com\",\n    \"contactPhone\": \"12345678\",\n    \"website\": \"https://miempresa.com\"\n}"
						},
						"url": {
							"raw": "http://localhost:3000/coperex/v1/companies",
							"host": ["http://localhost:3000"],
							"path": ["coperex", "v1", "companies"]
						},
						"description": "PMA punto 2 - Registro de empresas. Datos clave: nivel de impacto (impactLevel), años de trayectoria (yearsOfExperience), categoría empresarial (category). Adicionales: companyName, contactEmail, contactPhone, description, website. Todos obligatorios excepto description y website. contactPhone: 8 dígitos."
					}
				},
				{
					"name": "Actualizar empresa",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"companyName\": \"Mi Empresa Actualizada\",\n    \"yearsOfExperience\": 10\n}"
						},
						"url": {
							"raw": "http://localhost:3000/coperex/v1/companies/:id",
							"host": ["http://localhost:3000"],
							"path": ["coperex", "v1", "companies", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "",
									"description": "ID de la empresa (MongoDB ObjectId)"
								}
							]
						},
						"description": "PMA punto 3 - Editar empresa. Actualización de la información de una empresa registrada. No existe eliminación (DELETE). Body: todos los campos opcionales (companyName, impactLevel, yearsOfExperience, category, description, contactEmail, contactPhone, website)."
					}
				}
			]
		}
	]
}
